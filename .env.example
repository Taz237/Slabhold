# Supabase (accounts, collection, and sold-comps cache)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: required for sold_comps_cache writes (service role only)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Trawl — sold listings (https://trawl.dev/console/keys)
# Server-only. Never expose this to the browser.
TRAWL_API_KEY=

# Comps source: trawl | sample | off (default sample when unset)
COMPS_SOURCE=

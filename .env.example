# Canonical origin for metadata and share links.
# Preview deployments (VERCEL_ENV=preview) keep the preview host for share links.
# Auth email redirects use the browser origin so the PKCE cookie matches.
NEXT_PUBLIC_SITE_URL=https://slabhold.app

# Supabase (accounts, collection, and sold-comps cache)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare Turnstile site key (public). Leave unset to skip the check on sign-in forms.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Required for sold_comps_cache + comps_rate_limits (service role only; no anon fallback)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Trawl — sold listings (https://trawl.dev/console/keys)
# Server-only. Never expose this to the browser.
TRAWL_API_KEY=

# Comps source: trawl | sample | off (default sample when unset)
COMPS_SOURCE=

# Vercel cron auth for /api/cron/refresh-card-values (Authorization: Bearer …)
CRON_SECRET=

# Comma-separated Supabase user ids allowed to open /admin/reports. Server-only.
# ADMIN_USER_IDS=

# Cards checked per daily value cron (default 25, hard max 100)
# TRAWL_CRON_BUDGET=25

# Salt for the anonymous card-value IP hash. Server-only.
# If unset, the unsalted hash is used and the server logs one warning.
# Changing this resets existing anon rate-limit buckets. That is fine.
RATE_LIMIT_SALT=

# Web Push (VAPID). Generate once with `npx web-push generate-vapid-keys`.
# Leave all three empty and push stays off: no soft-ask, Settings says
# "Notifications aren't available yet", and the server sends nothing.
# The public key is safe to expose. The private key is a secret, server only.
# Rotating the pair drops every existing subscription.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

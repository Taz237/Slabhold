# Canonical origin for metadata and share links.
# Preview deployments (VERCEL_ENV=preview) keep the preview host for share links.
# Auth email redirects use the browser origin so the PKCE cookie matches.
NEXT_PUBLIC_SITE_URL=https://slabhold.app

# Supabase (accounts, collection, and sold-comps cache)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare Turnstile site key (public). Leave unset to skip the check on sign-in forms.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Required for sold_comps_cache + comps_rate_limits (service role only; no anon fallback)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Trawl — sold listings (https://trawl.dev/console/keys)
# Server-only. Never expose this to the browser.
TRAWL_API_KEY=

# GIPHY — GIF search in the post and reply composers (https://developers.giphy.com/dashboard)
# Server-only. Never expose this to the browser. Unset: the picker says GIFs aren't set up.
GIPHY_API_KEY=

# Comps source: trawl | sample | off (default sample when unset)
COMPS_SOURCE=

# Vercel cron auth for /api/cron/refresh-card-values (Authorization: Bearer …)
CRON_SECRET=

# Comma-separated Supabase user ids allowed to open /admin/reports. Server-only.
# ADMIN_USER_IDS=

# Cards checked per daily value cron (default 25, hard max 100)
# TRAWL_CRON_BUDGET=25

# Salt for the anonymous card-value IP hash. Server-only.
# If unset, the unsalted hash is used and the server logs one warning.
# Changing this resets existing anon rate-limit buckets. That is fine.
RATE_LIMIT_SALT=

# Web Push (VAPID). Generate once with `npx web-push generate-vapid-keys`.
# Leave all three empty and push stays off: no soft-ask, Settings says
# "Notifications aren't available yet", and the server sends nothing.
# The public key is safe to expose. The private key is a secret, server only.
# Rotating the pair drops every existing subscription.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# iPhone app push (APNs). Production only (TestFlight and App Store builds).
# Leave any of the four empty and APNs stays off: the app keeps its
# "Notifications aren't on in the iPhone app yet" note, and web push is unchanged.
# APNS_PRIVATE_KEY is the whole .p8 file (BEGIN/END lines included). It is a
# secret: set it in Vercel only, never here.
# APNS_KEY_ID=
# APNS_TEAM_ID=Z45KCV676K
# APNS_BUNDLE_ID=app.slabhold
# APNS_PRIVATE_KEY=

# Sign in with Apple: revoke the token when someone deletes their account
# (App Store rule 5.1.1(v)). Server only. Leave any of the four empty and
# revoke stays off: the delete still runs, and an Apple login is shown where
# to remove Slabhold in Settings. Set them in Vercel (Production), then
# redeploy. Never commit a value.
# APPLE_TEAM_ID: the 10-character Team ID, top right of the Apple Developer
#   account. The same team as APNS_TEAM_ID.
# APPLE_KEY_ID: developer.apple.com/account > Certificates, Identifiers &
#   Profiles > Keys > the key with Sign in with Apple ticked > Key ID.
#   Not the APNs key.
# APPLE_CLIENT_ID: the Services ID already used for web Sign in with Apple
#   (the first Client ID in Supabase > Authentication > Providers > Apple).
#   Not the app bundle id.
# APPLE_PRIVATE_KEY: the whole .p8 file for that Sign in with Apple key
#   (BEGIN/END lines included). It is a secret: set it in Vercel only, never
#   here. Do not reuse APNS_PRIVATE_KEY.
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_CLIENT_ID=
# APPLE_PRIVATE_KEY=
